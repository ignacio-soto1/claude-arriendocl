{
  "name": "arriendo-en-cl-app",
  "version": "1.0.0",
  "private": true,
  "description": "App de Arriendo en CL para Android y iOS (Capacitor). Usa el sitio de ../docs.",
  "scripts": {
    "web": "node copiar-web.js",
    "sync": "npm run web && npx cap sync",
    "iconos": "npx capacitor-assets generate --iconBackgroundColor '#0f2a3d' --splashBackgroundColor '#ffffff' --splashBackgroundColorDark '#0d1820'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
