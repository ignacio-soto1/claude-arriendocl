<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} · ${marca.nombre}` : `${marca.nombre} · Arriendo de parcelas y departamentos en Chile` %></title>
  <meta name="description" content="Arrienda parcelas, departamentos, casas y cabañas por noche en todo Chile.">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<header class="top">
  <a class="logo" href="/" aria-label="<%= marca.nombre %>, inicio">arriendo<span>en</span>CL</a>
  <nav>
    <% if (user) { %>
      <a href="/mis-reservas" class="<%= path === '/mis-reservas' ? 'on' : '' %>">Mis reservas</a>
      <% if (user.es_anfitrion) { %>
        <a href="/anfitrion" class="<%= path.startsWith('/anfitrion') ? 'on' : '' %>">Panel anfitrión</a>
      <% } else { %>
        <a href="/anfitrion/activar">Publica tu propiedad</a>
      <% } %>
      <form method="post" action="/salir" class="inline"><button class="link">Salir</button></form>
    <% } else { %>
      <a href="/anfitrion/activar">Publica tu propiedad</a>
      <a href="/ingresar">Ingresar</a>
      <a href="/registro" class="btn sm">Crear cuenta</a>
    <% } %>
  </nav>
</header>
<% if (flash) { %><div class="flash <%= flash.type %>" role="status"><%= flash.msg %></div><% } %>
<main>
