<%- include('partials/header') %>
<div class="row between wrap">
  <h1>Panel de anfitrión</h1>
  <a class="btn" href="/anfitrion/propiedades/nueva">+ Nueva propiedad</a>
</div>
<div class="stats">
  <div><span class="muted small">Ingresos confirmados</span><strong><%= formatCLP(stats.ingresos) %></strong></div>
  <div><span class="muted small">Reservas confirmadas</span><strong><%= stats.confirmadas %></strong></div>
  <div><span class="muted small">Por responder</span><strong><%= stats.pendientes %></strong></div>
</div>

<h2>Reservas recibidas</h2>
<% if (!reservas.length) { %><p class="muted">Todavía no recibes reservas.</p><% } else { %>
<div class="tabla-wrap"><table class="tabla">
  <thead><tr><th>#</th><th>Propiedad</th><th>Huésped</th><th>Fechas</th><th>Tú recibes</th><th>Estado</th><th></th></tr></thead>
  <tbody>
  <% reservas.forEach(b => { %>
    <tr>
      <td><%= b.id %></td>
      <td><a href="/propiedades/<%= b.listing_id %>"><%= b.titulo %></a></td>
      <td><%= b.huesped_nombre %><br><span class="small muted"><%= b.huespedes %> pers.<% if (b.estado === 'confirmada') { %> · <%= b.huesped_email %><%= b.huesped_telefono ? ` · ${b.huesped_telefono}` : '' %><% } %></span></td>
      <td><%= formatFecha(b.check_in) %> → <%= formatFecha(b.check_out) %><br><span class="small muted"><%= b.noches %> noches</span></td>
      <td><%= formatCLP(b.subtotal + b.limpieza) %></td>
      <td><%- include('partials/estado', { estado: b.estado }) %></td>
      <td><div class="acciones">
        <% if (b.estado === 'pendiente') { %>
          <form method="post" action="/anfitrion/reservas/<%= b.id %>/aceptar"><button class="btn sm">Aceptar</button></form>
          <form method="post" action="/anfitrion/reservas/<%= b.id %>/rechazar" data-confirm="¿Rechazar esta solicitud?"><button class="btn ghost sm">Rechazar</button></form>
        <% } %>
      </div></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<% } %>

<h2>Mis propiedades</h2>
<% if (!propiedades.length) { %><p class="empty">Aún no publicas propiedades. <a href="/anfitrion/propiedades/nueva">Publica la primera</a>.</p><% } %>
<div class="lista">
<% propiedades.forEach(l => { %>
  <div class="item">
    <a class="item-img" href="/propiedades/<%= l.id %>"><%- include('partials/foto', { foto: l.foto, tipo: l.tipo, alt: l.titulo }) %></a>
    <div class="item-body">
      <div class="row between"><a href="/propiedades/<%= l.id %>"><strong><%= l.titulo %></strong></a>
        <span class="estado <%= l.activo ? 'confirmada' : 'cancelada' %>"><%= l.activo ? 'Publicada' : 'Pausada' %></span></div>
      <div class="muted small"><%= TIPOS[l.tipo] %> · <%= l.comuna %>, <%= l.region %></div>
      <div><%= formatCLP(l.precio_noche) %> / noche<% if (l.pendientes) { %> · <strong><%= l.pendientes %> solicitud(es) por responder</strong><% } %></div>
      <div class="acciones"><a class="btn ghost sm" href="/anfitrion/propiedades/<%= l.id %>/editar">Editar</a></div>
    </div>
  </div>
<% }) %>
</div>
<%- include('partials/footer') %>
