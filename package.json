{
  "name": "arriendo-en-cl",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de arriendo de parcelas, departamentos, casas y cabañas en Chile",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.js",
    "seed": "node --no-warnings=ExperimentalWarning src/seed.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"test/*.test.js\"",
    "paginas": "node scripts/generar-paginas.js"
  },
  "dependencies": {
    "cookie-session": "^2.1.1",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  }
}
